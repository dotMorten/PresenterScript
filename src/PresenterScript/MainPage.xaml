<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PresenterScript.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="OnTogglePresentAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TimerButton"
                Margin="8,0,0,0"
                Padding="10,4"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind Timer.DisplayText, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Timer settings">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{x:Bind TimerBrush(Timer.State), Mode=OneWay}"
                        Glyph="&#xE916;" />
                    <TextBlock
                        x:Name="TimerText"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind TimerBrush(Timer.State), Mode=OneWay}"
                        Text="{x:Bind Timer.DisplayText, Mode=OneWay}" />
                    <Border
                        x:Name="PacePill"
                        Padding="10,2"
                        VerticalAlignment="Center"
                        Background="{x:Bind PaceBrush(Timer.PaceDelta), Mode=OneWay}"
                        CornerRadius="12"
                        Visibility="{x:Bind Timer.HasPace, Mode=OneWay}">
                        <TextBlock
                            x:Name="PaceText"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind PaceTextBrush(Timer.PaceDelta), Mode=OneWay}"
                            Text="{x:Bind Timer.PaceText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel MinWidth="260" Spacing="12">
                            <RadioButtons
                                x:Name="TimerModeRadio"
                                Header="Timer"
                                SelectedIndex="{x:Bind Timer.ModeIndex, Mode=TwoWay}">
                                <x:String>Off</x:String>
                                <x:String>Count down to end time</x:String>
                                <x:String>Count up</x:String>
                            </RadioButtons>
                            <TimePicker
                                x:Name="TimerEndTimePicker"
                                Header="End time"
                                SelectedTime="{x:Bind Timer.EndTime, Mode=TwoWay}"
                                Visibility="{x:Bind Timer.IsCountDown, Mode=OneWay}" />
                            <StackPanel Spacing="8" Visibility="{x:Bind Timer.IsNotCountDown, Mode=OneWay}">
                                <TimePicker
                                    x:Name="TimerStartTimePicker"
                                    Header="Talk start time"
                                    SelectedTime="{x:Bind Timer.StartTime, Mode=TwoWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Timer.StartedText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Button
                                    x:Name="TimerRestartButton"
                                    Command="{x:Bind Timer.RestartCommand}"
                                    Content="Restart talk clock now" />
                                <TextBlock
                                    MaxWidth="260"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Timer.PaceBasisText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <CommandBar
                x:Name="Toolbar"
                Grid.Column="1"
                HorizontalAlignment="Left"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True"
                OverflowButtonVisibility="Auto">
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Name="PresentationSettingsButton"
                        AutomationProperties.Name="Presenter settings"
                        Click="OnPresentationSettingsClick"
                        Icon="Setting"
                        Label="Presenter settings" />
                </CommandBar.SecondaryCommands>
                <AppBarButton
                    AutomationProperties.Name="New"
                    Command="{x:Bind ViewModel.NewCommand}"
                    Icon="Page2"
                    Label="New"
                    ToolTipService.ToolTip="New (Ctrl+N)"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.Name="Open"
                    Command="{x:Bind ViewModel.OpenCommand}"
                    Icon="OpenFile"
                    Label="Open"
                    ToolTipService.ToolTip="Open (Ctrl+O)"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    x:Name="RecentButton"
                    AutomationProperties.Name="Recent files"
                    Label="Recent"
                    ToolTipService.ToolTip="Recently opened files"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="RecentFlyout" Opening="OnRecentFlyoutOpening" Placement="BottomEdgeAlignedLeft" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.Name="Save"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Icon="Save"
                    Label="Save"
                    ToolTipService.ToolTip="Save (Ctrl+S)"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.Name="Save as"
                    Command="{x:Bind ViewModel.SaveAsCommand}"
                    Label="Save as"
                    ToolTipService.ToolTip="Save as (Ctrl+Shift+S)"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE792;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.Name="Revert"
                    Command="{x:Bind ViewModel.RevertCommand}"
                    Label="Revert"
                    ToolTipService.ToolTip="Discard unsaved changes. Otherwise they're kept when you close the app and restored on the next launch."
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
                <AppBarButton
                    x:Name="HelpButton"
                    AutomationProperties.Name="Help"
                    Click="OnHelpClick"
                    Label="Help"
                    ToolTipService.ToolTip="Script syntax and shortcuts (F1)"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />
                <AppBarButton
                    x:Name="ModeButton"
                    AutomationProperties.Name="{x:Bind ViewModel.ModeButtonText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.TogglePresentCommand}"
                    Label="{x:Bind ViewModel.ModeButtonText, Mode=OneWay}"
                    ToolTipService.ToolTip="Switch between edit and presenter mode (F5 / Esc)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="{x:Bind ViewModel.ModeButtonGlyph, Mode=OneWay}" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.Name="Reset to start"
                    Command="{x:Bind ViewModel.ResetToStartCommand}"
                    Label="Reset to start"
                    ToolTipService.ToolTip="Highlight the first section (Home)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ToggleSwitch
                        x:Name="AutoCopyNextToggle"
                        Margin="8,0"
                        AutomationProperties.Name="Auto-copy next snippet"
                        IsOn="{x:Bind ViewModel.AutoCopyNext, Mode=TwoWay}"
                        OffContent="Auto-copy next"
                        OnContent="Auto-copy next"
                        ToolTipService.ToolTip="After a snippet is pasted somewhere, put the next snippet on the clipboard" />
                </AppBarElementContainer>
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <TextBlock
                        x:Name="SectionStatusText"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SectionStatus, Mode=OneWay}" />
                </AppBarElementContainer>
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="PresentationErrorBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning"
            Title="Presenter setting could not be applied" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="Editor"
                Margin="8,0,4,8"
                AcceptsReturn="True"
                AutomationProperties.Name="Markdown editor"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="14"
                IsSpellCheckEnabled="False"
                PlaceholderText="# My talk&#x0a;&#x0a;Write your script in Markdown. Put code you want to paste in ``` fenced blocks."
                PreviewKeyDown="OnEditorPreviewKeyDown"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}" />

            <Border
                x:Name="PreviewHost"
                Grid.Column="1"
                Margin="4,0,8,8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <WebView2 x:Name="Preview" AutomationProperties.Name="Rendered script" />
            </Border>
        </Grid>
    </Grid>
</Page>
